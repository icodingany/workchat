{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "allow-desktop-operation",
    "allow-open-external-url",
    "allow-check-for-updates",
    "allow-quit-and-install"
  ]
}
