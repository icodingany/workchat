{
  "name": "jubo-work-chat",
  "version": "1.4.5",
  "private": true,
  "description": "Customer source delivery with local service configuration",
  "scripts": {
    "serve": "vite --mode development",
    "stage": "vite --mode stage",
    "build:no-changelog": "vite build",
    "build:test": "vite build --mode test",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:build:android": "npm run build && npx cap sync && npx cap open android",
    "vite:dev": "electron-vite dev --mode development.electron",
    "vite:build": "electron-vite build --mode production.electron",
    "vite:preview": "electron-vite preview",
    "vite:pack": "node scripts/pack-win.js",
    "pack:win": "node scripts/pack-win.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "install:electron-deps": "electron-builder install-app-deps",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:gate": "npm run test:unit && npm run test:coverage",
    "start": "vite --mode development",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8090",
    "install:web": "npm ci --ignore-scripts --no-audit --no-fund"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.11.1",
    "animate.css": "^3.7.2",
    "axios": "^1.18.1",
    "core-js": "^3.39.0",
    "dayjs": "^1.8.17",
    "default-passive-events": "^1.0.10",
    "dexie": "^4.4.3",
    "electron-updater": "^6.8.3",
    "element-plus": "^2.14.3",
    "lodash": "^4.17.21",
    "mitt": "^3.0.1",
    "number-precision": "^1.3.2",
    "qs": "^6.15.3",
    "vant": "^4.10.0",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "vuex": "^4.1.0",
    "xlsx": "^0.17.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "cross-env": "^7.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.1",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^17.7.0",
    "jsdom": "^25.0.1",
    "patch-package": "^8.0.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.83.0",
    "sinon": "^22.0.0",
    "vconsole": "3.15.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.7",
    "vue-eslint-parser": "^10.4.1"
  },
  "main": "out/main/index.js",
  "productName": "企聊客服系统",
  "engines": {
    "node": ">=22.12.0"
  }
